# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Cloud Messaging VAPID Key (for Web Push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NEXUS

# Optional: Google Gemini API for AI task breakdown and smarter parsing
# Free tier at https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=
# Optional: Google OAuth client ID for multi-account Google Calendar sync
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
